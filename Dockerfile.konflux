# Multi-stage build for the evaluation hub Go service
# Build stage
FROM registry.access.redhat.com/ubi10/go-toolset:1.26@sha256:e94c38ff4a099b755af60c73ac87198c613f369eb7f818d45c96fbc3f21047de AS builder

ARG TARGETOS
ARG TARGETARCH

USER 0

# Set working directory
WORKDIR /build

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build arguments for versioning, please ensure to modify also in the Runtime stage below
ARG BUILD_NUMBER=1.0.1
ARG BUILD_DATE
ARG BUILD_PACKAGE=main
ARG GIT_HASH

# Resolve the build timestamp once so all binaries share the same metadata.
# An explicit BUILD_DATE takes precedence over the UTC compilation timestamp.
RUN BUILD_DATE="${BUILD_DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" && \
    export CGO_ENABLED=1 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} GOEXPERIMENT=strictfipsruntime && \
    BUILD_LDFLAGS="-w -s -X '${BUILD_PACKAGE}.Build=${BUILD_NUMBER}' -X '${BUILD_PACKAGE}.BuildDate=${BUILD_DATE}' -X '${BUILD_PACKAGE}.GitHash=${GIT_HASH}'" && \
    go build -ldflags="${BUILD_LDFLAGS}" -a -installsuffix cgo -o eval-hub ./cmd/eval_hub && \
    go build -ldflags="${BUILD_LDFLAGS}" -a -installsuffix cgo -o eval-runtime-sidecar ./cmd/eval_runtime_sidecar && \
    go build -ldflags="${BUILD_LDFLAGS}" -a -installsuffix cgo -o eval-runtime-init ./cmd/eval_runtime_init && \
    go build -ldflags="${BUILD_LDFLAGS}" -a -installsuffix cgo -o evalhub-mcp ./cmd/evalhub_mcp

# Runtime stage
FROM registry.redhat.io/ubi10/ubi-minimal:10.3@sha256:cc3d766e796fbb50d6fcd599f4bad4c231aeae41822c6e86e7da664a996221ca

# Create user and app directory.
# UBI 10 minimal no longer ships shadow-utils (groupadd/useradd), and the Konflux
# build is hermetic (no network/prefetched RPMs), so the group and passwd entries
# are written directly instead of installing shadow-utils to run groupadd/useradd.
RUN printf 'evalhub:x:1000:\n' >> /etc/group && \
    printf 'evalhub:x:1000:1000:Eval Hub:/home/evalhub:/bin/bash\n' >> /etc/passwd && \
    mkdir -p /home/evalhub /app/docs && \
    if [ -d /etc/skel ]; then cp -a /etc/skel/. /home/evalhub/; fi && \
    chown -R evalhub:evalhub /home/evalhub /app && \
    chmod 700 /home/evalhub

# Copy binaries from builder
COPY --from=builder --chown=evalhub:evalhub /build/eval-hub /app/eval-hub
COPY --from=builder --chown=evalhub:evalhub /build/eval-runtime-sidecar /app/eval-runtime-sidecar
COPY --from=builder --chown=evalhub:evalhub /build/eval-runtime-init /app/eval-runtime-init
COPY --from=builder --chown=evalhub:evalhub /build/evalhub-mcp /app/evalhub-mcp

# The swagger source files required for the openapi.yaml and docs
COPY --chown=evalhub:evalhub docs/openapi.* /app/docs/

# Set working directory
WORKDIR /app

# Switch to non-root user
USER evalhub

# Expose service port
EXPOSE 8080

# Environment variables
ENV PORT=8080 \
    TZ=UTC

# Redeclare build ARGs for labels (ARGs don't cross stage boundaries)
ARG BUILD_NUMBER=1.0.1
ARG BUILD_DATE

# Labels for metadata
LABEL org.opencontainers.image.title="eval-hub" \
      org.opencontainers.image.description="Evaluation Hub REST API service" \
      org.opencontainers.image.version="${BUILD_NUMBER}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.authors="eval-hub" \
      org.opencontainers.image.vendor="eval-hub"

# Health check removed - wget not available without package installation

# Run the binary
CMD ["/app/eval-hub"]

LABEL com.redhat.component="odh-eval-hub-rhel9" \
      name="rhoai/odh-eval-hub-rhel9" \
      description="odh-eval-hub" \
      summary="odh-eval-hub" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-eval-hub" \
      io.k8s.description="odh-eval-hub" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
